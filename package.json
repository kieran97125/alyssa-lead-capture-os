{
  "name": "alyssa-lead-capture-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:public-lead-contract && npm run verify:auth-email-contract && npm run verify:reporting-trend-contract && npm run verify:report-export-contract && npm run verify:treatment-mapping-contract && npm run verify:brand-scope-contract && npm run verify:lead-audit-contract && npm run verify:product-ui-contract && npm run verify:app-icon-contract && npm run verify:work-ops-contract && npm run verify:design-system-contract && npm run verify:creative-production-contract && npm run verify:calendar-edit-contract && next build",
    "start": "next start",
    "lint": "eslint",
    "verify:public-lead-contract": "node scripts/verify-public-lead-contract.mjs",
    "verify:auth-email-contract": "node scripts/verify-auth-email-contract.mjs",
    "verify:reporting-trend-contract": "node scripts/verify-reporting-trend-contract.mjs",
    "verify:report-export-contract": "node scripts/verify-report-export-contract.mjs",
    "verify:treatment-mapping-contract": "node scripts/verify-treatment-mapping-contract.mjs",
    "verify:brand-scope-contract": "node scripts/verify-brand-scope-contract.mjs",
    "verify:lead-audit-contract": "node scripts/verify-lead-audit-contract.mjs",
    "verify:product-ui-contract": "node scripts/verify-product-ui-contract.mjs",
    "verify:app-icon-contract": "node scripts/verify-app-icon-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "sync:auth-email-templates": "node scripts/sync-supabase-auth-email-templates.mjs",
    "verify:work-ops-contract": "node scripts/verify-work-task-push-contract.mjs",
    "verify:design-system-contract": "node scripts/verify-design-system-contract.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --quiet",
    "test:design": "playwright test e2e/design-quality.spec.ts",
    "test:design:update": "playwright test e2e/design-quality.spec.ts --update-snapshots",
    "design:ci": "npm run verify:design-system-contract && npm run build:storybook && npm run test:design",
    "verify:creative-production-contract": "node scripts/verify-creative-production-contract.mjs",
    "test:creative": "playwright test e2e/creative-production.spec.ts",
    "verify:calendar-edit-contract": "node scripts/verify-calendar-edit-contract.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "10.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "4.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-file-handler": "3.30.6",
    "@tiptap/extension-image": "3.30.6",
    "@tiptap/extension-link": "3.30.6",
    "@tiptap/extension-placeholder": "3.30.6",
    "@tiptap/extension-task-item": "3.30.6",
    "@tiptap/extension-task-list": "3.30.6",
    "@tiptap/extension-underline": "3.30.6",
    "@tiptap/react": "3.30.6",
    "@tiptap/starter-kit": "3.30.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.40.0",
    "next": "16.2.12",
    "pptxgenjs": "4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.19.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
