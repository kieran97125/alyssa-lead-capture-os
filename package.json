    "verify:report-export-contract": "node scripts/verify-report-export-contract.mjs",
    "verify:brand-scope-contract": "node scripts/verify-brand-scope-contract.mjs",
    "verify:lead-audit-contract": "node scripts/verify-lead-audit-contract.mjs",
    "verify:product-ui-contract": "node scripts/verify-product-ui-contract.mjs",
    "verify:app-icon-contract": "node scripts/verify-app-icon-contract.mjs",
